# Copy to .env and fill in real values. Never commit .env.
# Used by docker-compose.yml and read by the backend as environment variables.

POSTGRES_PASSWORD=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=college_db
DB_USER=college_app
DB_PASSWORD=

# Base64 string of at least 32 random bytes:  openssl rand -base64 48
JWT_SECRET=

# Creates the first Super Admin on startup when no admin exists yet.
BOOTSTRAP_ADMIN_EMAIL=admin@college.edu
BOOTSTRAP_ADMIN_PASSWORD=

CORS_ORIGINS=http://localhost:5173
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
